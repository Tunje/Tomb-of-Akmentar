		"trail_germans": {
			"speaker": "player",
			"line": "Hoofprints, a lot of them, and a cold fire. Under the ash, a torn page in German: a train timetable, Cairo to Alexandria.",
			"do": [
				{
					"journal": [
						"act6_road",
						"trail_germans",
						"the desert road"
					]
				},
				{
					"set_flag": "lead_station"
				}
			],
			"next": "night"
		},
		"trail_italians": {
			"speaker": "player",
			"line": "Tyre tracks on the coast road, and a ditched crate stencilled 'Ricambi Ferraro'. Truck parts. They'll need a garage in Cairo, and a permit to get trucks out of the city.",
			"do": [
				{
					"journal": [
						"act6_road",
						"trail_italians",
						"the coast road"
					]
				},
				{
					"set_flag": "lead_police"
				}
			],
			"next": "night"
		},
		"night": {
			"speaker": "player",
			"line": "The second night. Something stands at the edge of the firelight, very still, and it isn't a man.",
			"next": "react"
		},
		"react": {
			"branch": [
				{
					"if": {
						"in_party": "isabelle"
					},
					"next": "r_isabelle"
