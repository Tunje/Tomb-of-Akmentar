					"next": "r_eleanor"
				},
				{
					"if": {
						"in_party": "youssef"
					},
					"next": "r_youssef"
				},
				{
					"next": "choose"
				}
			]
		},
		"r_isabelle": {
			"speaker": "isabelle",
			"line": "I put two shots into it. It didn't even look at me. It's looking at the road behind us.",
			"next": "choose"
		},
		"r_hargreaves": {
			"speaker": "hargreaves",
			"line": "Everyone up. Back to back. Nobody goes for water alone, not tonight.",
			"next": "choose"
		},
		"r_hassan": {
			"speaker": "hassan",
			"line": "His servants. He sends them ahead to see where the amulet goes. They are not here for us. Not yet.",
			"next": "choose"
		},
		"r_eleanor": {
			"speaker": "eleanor",
			"line": "Those wrappings... they're the same as the bodies in the lower halls. It walked here. All this way.",
			"next": "choose"
		},
		"r_youssef": {
			"speaker": "youssef",
			"line": "I am not afraid. I am not afraid. I am... a little afraid.",
			"next": "choose"
		},
		"choose": {
			"speaker": "player",
			"line": "It isn't coming closer. Not yet.",
			"choices": [
				{
					"label": "Break camp and ride",
					"line": "Pack up. We ride now, in the dark.",
					"do": [
						{
							"set_flag": "act6_night_ride"
						}
					],
					"next": "ride_fear_0",
					"slot": "r"
				},
				{
					"label": "Hold the camp",
					"line": "Nobody runs. We hold here until morning.",
					"next": "hold",
					"slot": "ur"
				}
			]
		},
		"hold": {
			"speaker": "player",
			"line": "Shapes come out of the dark, more of them now.",
