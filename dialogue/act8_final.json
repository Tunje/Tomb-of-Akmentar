{
	"_help": "Act 8, the final approach: go down into the tomb (act8_choice = descend, end_descend: Act 9), or surrender the amulet to the guardian (player_sacrificed; end_sacrifice: straight to the epilogue). The sacrifice saves the companions only if they're far away: sent off first (companions_sent_away; Isabelle or Eleanor with trust >= 3 refuse and stay, and die), left in Cairo by the plane (left_in_cairo), or covered by Hargreaves's rearguard (rear_held). Otherwise sacrifice_failed and every companion present dies. Generated by tools/dialogue/make_act89.py.",
	"speakers": {
		"player": "You",
		"eleanor": "Eleanor Whitmore",
		"pembroke": "Dr. Arthur Pembroke",
		"hassan": "Dr. Hassan al-Masri",
		"hargreaves": "Tom Hargreaves",
		"idris": "Idris Mahjoub",
		"isabelle": "Isabelle Moreau",
		"saleh": "Saleh al-Rashidi",
		"youssef": "Youssef Nabil",
		"farid": "Farid Mansour",
		"mahmoud": "Mahmoud Fawzi",
		"khalil": "Khalil Darwish",
		"naguib": "Naguib Sabet"
	},
	"start": "start",
	"nodes": {
		"start": {
			"speaker": "player",
			"line": "Akmentar. And on the ridge above the ruins, waiting, the guardian. He isn't attacking. He's waiting for the amulet.",
			"next": "choice"
		},
		"choice": {
			"speaker": "player",
			"line": "Down into the tomb with it, or out there to him.",
			"choices": [
				{
					"label": "Go down into the tomb",
					"line": "We take it home ourselves. Into the tomb.",
					"next": "descend"
				},
				{
					"label": "Send the others away",
					"line": "Everyone back to the horses. Ride, and don't look back.",
					"if": {
						"not_flag": "companions_sent_away"
					},
					"next": "send_refuse"
				},
				{
					"label": "Walk out to him",
					"line": "I'll take it to him myself.",
					"next": "surrender"
				}
			]
		},
		"descend": {
			"speaker": "player",
			"line": "Into the dark, then. One more time.",
			"do": [
				{
					"set_flag": [
						"act8_choice",
						"descend"
					]
				}
			],
			"next": "end_descend"
		},
		"send_refuse": {
			"branch": [
				{
					"if": {
						"in_party": "isabelle",
