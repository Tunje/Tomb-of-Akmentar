		"e_eleanor": {
			"speaker": "eleanor",
			"line": "Wait. Those columns on the ridge: that's a temple, and an old one. If anyone left word about Akmentar, it's there. A day, at most. Please.",
			"next": "g"
		},
		"e_pembroke": {
			"speaker": "pembroke",
			"line": "A temple, and not on any survey I know. I can't ride past an unrecorded site. Professionally, I simply can't.",
			"next": "g"
		},
		"e_hassan": {
			"branch": [
				{
					"if": {
						"flag": "hassan_heard_greed"
					},
					"next": "e_hassan_lie"
				},
				{
					"next": "e_hassan_true"
				}
			]
		},
		"e_hassan_lie": {
			"speaker": "hassan",
			"line": "A ruined chapel, nothing more. The sand has had it for centuries. The town has water; I would go there.",
			"do": [
				{
					"set_flag": "hassan_misdirected"
				}
			],
			"next": "g"
		},
		"e_hassan_true": {
			"speaker": "hassan",
			"line": "The temple of the three gods. My teachers spoke of it. Whatever is written there was written for travellers like us.",
			"next": "g"
		},
		"g": {
			"branch": [
				{
					"if": {
						"in_party": "saleh"
					},
					"next": "g_saleh"
				},
				{
					"if": {
						"in_party": "youssef"
					},
					"next": "g_youssef"
				},
				{
					"if": {
						"in_party": "farid"
					},
					"next": "g_farid"
				},
				{
					"next": "g_none"
				}
			]
		},
		"g_saleh": {
			"speaker": "saleh",
			"line": "The town has wells and walls. The temple has neither. I have said what I think: the town.",
			"next": "decide"
		},
		"g_youssef": {
			"speaker": "youssef",
			"line": "I know a quick road to the town. We would be there by night, with water and fresh horses. The temple can wait for another expedition, no?",
			"next": "decide"
		},
		"g_farid": {
			"speaker": "farid",
			"line": "In the town there is a merchant, Mariam Amin, who owes me favours. Fresh water, fair prices. A temple sells nothing.",
			"next": "decide"
		},
		"g_none": {
			"speaker": "player",
			"line": "No guide to argue for the town. Only the water skins, and they're lighter than I'd like.",
			"next": "decide"
		},
		"decide": {
			"speaker": "player",
			"line": "The temple or the town. My call.",
			"choices": [
				{
					"label": "The temple",
					"line": "We go to the temple. One day, no more.",
					"do": [
						{
							"set_flag": "fork_temple"
						}
					],
					"next": "temple_fx_0",
					"slot": "ur"
				},
				{
					"label": "The town",
					"line": "The town. Water first, history later.",
					"do": [
